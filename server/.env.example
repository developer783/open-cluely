# Copy to server/.env for local runs. On a hosting platform, set these as
# environment variables instead. Never commit the real values.

# One or more Gemini keys, comma-separated (the server fails over between them)
GEMINI_API_KEYS=

# AssemblyAI key used to mint short-lived streaming tokens
ASSEMBLYAI_API_KEY=

# Access codes your team enters in the app's Settings, comma-separated.
# Use long random values, e.g. one per person, so you can revoke individually.
ACCESS_CODES=

# Optional
PORT=8787
RATE_LIMIT_PER_MINUTE=30
MAX_BODY_MB=25
# Models the app may use through the server (comma-separated)
ALLOWED_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite-preview,gemini-3.5-flash,gemini-3.8-flash,gemini-3-flash-preview
